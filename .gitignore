# 忽略 Python 缓存文件
__pycache__/
*.pyc
*.pyo
*.pyd

# 忽略您提到的数据文件
*.mat
*.npy

# 强烈建议：忽略您项目中的数据输出目录
# 根据您的config.py，所有实验结果都存在这里
data/
output/

# 忽略常见的IDE/编辑器配置文件
.vscode/
.idea/

# 忽略常见的操作系统生成文件
.DS_Store
Thumbs.db
# Local upstream UESTC LaTeX template
third_party/
*:Zone.Identifier

# Local literature full-text cache (open-access PDFs are never committed)
docs/literature/fulltext_cache/

# LaTeX build artifacts (scoped to the thesis project)
thesis_latex/build/
thesis_latex/*.aux
thesis_latex/*.bbl
thesis_latex/*.blg
thesis_latex/*.fdb_latexmk
thesis_latex/*.fls
thesis_latex/*.log
thesis_latex/*.lof
thesis_latex/*.out
thesis_latex/*.pdf
thesis_latex/*.toc
thesis_latex/*.xdv
thesis_latex/*.lot
thesis_latex/*.synctex.gz
